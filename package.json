{
  "name": "builderhut",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant e-commerce site builder — sellers create, customise and publish a real storefront without code.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "test:watch": "tsx --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs",
    "e2e": "playwright test",
    "db:roles": "tsx --env-file-if-exists=.env.local scripts/db/apply-roles.mts",
    "db:generate": "drizzle-kit generate && node scripts/db/normalise-journal.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db/seed.mts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "verify": "pnpm check:contrast && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:secrets && pnpm check:budget"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "uuidv7": "^1.0.2",
    "ws": "^8.18.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.3",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  }
}
