# Copy to .env.local and fill in. .env* is gitignored except this file.

# --- Database -------------------------------------------------------------
# Pooled endpoint, connecting as the NOBYPASSRLS application role. This is what
# the app uses; RLS policies apply to it.
DATABASE_URL="postgresql://builderhut_app:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) endpoint as the OWNER role. Migrations and role management
# only — DDL needs a real session for advisory locks.
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Password assigned to builderhut_app by `pnpm db:roles`.
BUILDERHUT_APP_PASSWORD=""

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Wildcard host for published storefronts, once a domain exists.
# Until then stores are reachable at /s/<slug> and <slug>.lvh.me:3000.
STOREFRONT_DOMAIN=""

# --- Email (Phase 1) ------------------------------------------------------
# Unset means verification codes print to the dev console, so signup works offline.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BuilderHut <hello@builderhut.local>"

# --- Media, Cloudflare R2 (Phase 1) --------------------------------------
# Unset means uploads fall back to ./.uploads on local disk.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""

# --- AI, NVIDIA NIM (Phase 7) --------------------------------------------
# Unset means the assistant uses a deterministic mock generator.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL=""
