# Copy to .env.local and fill in. .env* is gitignored except this file.

# --- Database -------------------------------------------------------------
# Pooled endpoint, connecting as the NOBYPASSRLS application role. This is what
# the app uses; RLS policies apply to it.
DATABASE_URL="postgresql://builderhut_app:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) endpoint as the OWNER role. Migrations and role management
# only — DDL needs a real session for advisory locks.
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Password assigned to builderhut_app by `pnpm db:roles`.
BUILDERHUT_APP_PASSWORD=""

# --- App ------------------------------------------------------------------
# At least 32 characters. Required in production; development falls back to a
# fixed value so sessions survive a dev-server restart.
BETTER_AUTH_SECRET=""
# Shared secret for the nightly analytics rollup. Required in production;
# without it the cron endpoint refuses rather than running open.
CRON_SECRET=""
APP_URL="http://localhost:3000"

# Optional. Absent credentials simply means no social login button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Wildcard host for published storefronts, once a domain exists.
# Until then stores are reachable at /s/<slug> and <slug>.lvh.me:3000.
STOREFRONT_DOMAIN=""

# --- Email (Phase 1) ------------------------------------------------------
# Unset means verification codes print to the dev console, so signup works offline.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BuilderHut <hello@builderhut.local>"

# --- Media ----------------------------------------------------------------
# Which store backs the media library: 'kv' | 'r2' | 'local'.
# 'local' writes to ./.uploads and needs no credentials.
MEDIA_STORE="local"

# Cloudflare KV. Free tier: 1,000 writes/day, 25MiB per value — fine for building
# and demos, needs replacing with R2 before real merchants upload catalogues.
CF_ACCOUNT_ID=""
CF_KV_NAMESPACE_ID=""
CF_KV_API_TOKEN=""

# Cloudflare R2. Filling these in and setting MEDIA_STORE=r2 is the whole migration.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""

# --- AI, NVIDIA NIM (Phase 7) --------------------------------------------
# Unset means the assistant uses a deterministic mock generator.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL=""
